#!/bin/bash

#################################################################################
# DFIR Workstation Login Simulator
#
# This script provides an immersive entry experience for the Forensics Docker Lab
# It hides Docker commands and simulates logging into a dedicated DFIR workstation
#
# Usage: ./scripts/forensics-workstation [analyst_name]
# Example: ./scripts/forensics-workstation "Alice Johnson"
#################################################################################

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Configuration
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ANALYST_NAME="${1:-}"

# --- container engine ------------------------------------------------------
# Docker by default; Podman fully supported. Set CONTAINER_ENGINE=podman (or
# install only Podman) to use the same compose file under Podman.
ENGINE="${CONTAINER_ENGINE:-}"
if [ -z "$ENGINE" ]; then
  if command -v docker >/dev/null 2>&1; then ENGINE=docker
  elif command -v podman >/dev/null 2>&1; then ENGINE=podman
  fi
fi

ensure_podman_socket() {
  local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/podman/podman.sock"
  mkdir -p "$(dirname "$sock")"
  if [ ! -S "$sock" ]; then
    systemctl --user enable --now podman.socket >/dev/null 2>&1 || true
    for _ in 1 2 3 4 5; do [ -S "$sock" ] && break; sleep 1; done
  fi
  [ -S "$sock" ] || return 1
  export DOCKER_HOST="unix://$sock"
}

resolve_compose() {
  COMPOSE=()
  case "$ENGINE" in
    docker)
      if docker compose version >/dev/null 2>&1; then COMPOSE=(docker compose)
      elif command -v docker-compose >/dev/null 2>&1; then COMPOSE=(docker-compose)
      fi ;;
    podman)
      if podman compose version >/dev/null 2>&1; then COMPOSE=(podman compose)
      elif command -v podman-compose >/dev/null 2>&1; then COMPOSE=(podman-compose)
      elif command -v docker-compose >/dev/null 2>&1 && ensure_podman_socket; then
        COMPOSE=(docker-compose)
      fi ;;
  esac
}
resolve_compose

#################################################################################
# Functions
#################################################################################

print_banner() {
  echo
  echo -e "${BLUE}"
  echo "  +=====================================================================+"
  echo "  |                                                                     |"
  echo "  |     DIGITAL FORENSICS & INCIDENT RESPONSE LABORATORY                |"
  echo "  |                                                                     |"
  echo "  |    Cyber Security Investigation Environment                         |"
  echo "  |                                                                     |"
  echo "  +=====================================================================+"
  echo -e "${NC}"
}

check_engine() {
  if [ -z "$ENGINE" ] || ! command -v "$ENGINE" &>/dev/null; then
    echo -e "${RED}✗ Error: no container engine found (Docker or Podman)${NC}"
    echo "  Docker: https://www.docker.com/products/docker-desktop"
    echo "  Podman: https://podman.io/getting-started/installation"
    exit 1
  fi

  if ! "$ENGINE" info >/dev/null 2>&1; then
    echo -e "${RED}✗ Error: ${ENGINE} is not running${NC}"
    if [ "$ENGINE" = podman ]; then
      echo "  On macOS/Windows run: podman machine start"
    else
      echo "  Please start Docker Desktop and try again"
    fi
    exit 1
  fi

  if [ "${#COMPOSE[@]}" -eq 0 ]; then
    echo -e "${RED}✗ Error: no Compose front-end found for ${ENGINE}${NC}"
    echo "  Docker: install Docker Compose v2 (or docker-compose)"
    echo "  Podman: install podman-compose, or Docker Compose v2 for the Podman socket"
    exit 1
  fi

  # The dfir container needs /dev/fuse + SYS_ADMIN for ewfmount/xmount.
  if [ "$ENGINE" = podman ] \
     && [ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" = "true" ]; then
    echo -e "${YELLOW}⚠ Rootless Podman: FUSE mounts (ewfmount/xmount) may fail.${NC}"
    echo "  For the full toolbox, use rootful Podman:"
    echo "    macOS/Windows: podman machine set --rootful && podman machine stop && podman machine start"
    echo "    Linux:         run this lab as root"
    echo
  fi
}

check_evidence_files() {
  if [ ! -f "$PROJECT_ROOT/evidence/usb.img" ] && [ ! -f "$PROJECT_ROOT/evidence/usb.E01" ]; then
    echo -e "${YELLOW}⚠ Warning: No USB evidence found in evidence/ (Lab 1)${NC}"
    echo "  Generate it with: make evidence   (see docs/evidence-sources.md)"
    echo "  (Labs 3 & 4 use included evidence; Lab 2 needs a downloaded memory sample)"
    echo
    read -p "Continue anyway? (y/n) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      exit 0
    fi
  fi
}

prompt_analyst_name() {
  if [ -z "$ANALYST_NAME" ]; then
    echo -e "${CYAN}Forensic Analyst Login${NC}"
    read -p "Enter analyst name (for case documentation): " ANALYST_NAME

    if [ -z "$ANALYST_NAME" ]; then
      ANALYST_NAME="analyst"
    fi
  fi

  # Sanitize analyst name for use in environment variable
  ANALYST_NAME_SANITIZED=$(echo "$ANALYST_NAME" | tr ' ' '_' | tr -d '[:punct:]')
}

show_lab_summary() {
  echo
  echo -e "${CYAN}Lab Environment - Available Tasks:${NC}"
  echo "  1 - USB_Imaging - Evidence handling, imaging and initial triage"
  echo "  2 - Memory_Forensics - Memory analysis with Volatility 2"
  echo "  3 - Autopsy_GUI - Graphical forensic examination"
  echo "  4 - Email_Logs - Email artifact and log analysis"
  echo "  5 - Network_Analysis - Network traffic and C2 detection"
  echo "  6 - Final_Report - Synthesis and professional reporting"
  echo
  echo -e "${CYAN}Access Mode:${NC} All labs available in one environment"
  echo
  read -p "Continue to DFIR workstation? (y/n) [y]: " -r CONTINUE_CHOICE
  CONTINUE_CHOICE=${CONTINUE_CHOICE:-y}

  if [[ ! $CONTINUE_CHOICE =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}✗ Exiting without connecting${NC}"
    echo
    exit 0
  fi
}

connect_to_workstation() {
  echo
  echo -e "${BLUE}Connecting to DFIR Workstation...${NC}"
  sleep 1
  echo -e "${CYAN}Initializing forensic environment...${NC}"
  sleep 1
  echo -e "${GREEN}✓ Connection established${NC}"
  sleep 1
  echo

  # Build the compose command with analyst name
  cd "$PROJECT_ROOT"

  # Export analyst name as environment variable for the container
  export ANALYST_NAME="$ANALYST_NAME"

  # Run the interactive container with the analyst name passed in
  # The entrypoint script will use this to customize the prompt
  "${COMPOSE[@]}" run --rm \
    --env "ANALYST_NAME=$ANALYST_NAME_SANITIZED" \
    -it dfir bash

  # Container has exited
  echo
  echo -e "${CYAN}Disconnecting from DFIR Workstation...${NC}"
  sleep 1
  echo -e "${GREEN}✓ Session ended${NC}"
}

show_help() {
  echo -e "${CYAN}Usage:${NC}"
  echo "  ./scripts/forensics-workstation [analyst_name]"
  echo
  echo -e "${CYAN}Examples:${NC}"
  echo "  ./scripts/forensics-workstation"
  echo "  ./scripts/forensics-workstation 'Alice Johnson'"
  echo "  ./scripts/forensics-workstation analyst1"
  echo
  echo -e "${CYAN}Inside the workstation:${NC}"
  echo "  Command examples:"
  echo "    ewfverify /evidence/usb.E01"
  echo "    fls -r /evidence/usb.img"
  echo "    coc-log 'command' 'note about action'"
  echo
  echo "  Exit with: exit"
  echo
  echo -e "${YELLOW}For more information, see: docs/README.md${NC}"
}

#################################################################################
# Main
#################################################################################

main() {
  # Handle help flag
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    show_help
    exit 0
  fi

  # Print welcome banner
  print_banner

  # System checks
  check_engine
  check_evidence_files

  # Get analyst name
  prompt_analyst_name

  # Show lab summary and ask to proceed
  show_lab_summary

  # Connect to workstation
  connect_to_workstation

  # Cleanup and goodbye
  echo -e "${CYAN}Thank you for using the Forensics Lab. All work saved to ./cases/${NC}"
}

# Run main function
main "$@"
